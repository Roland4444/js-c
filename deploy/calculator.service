[Unit]
Description=Bitrix calculator
After=network-online.target
[Service]
User=calculator
Group=calculator
WorkingDirectory=/opt/calculator
EnvironmentFile=/etc/calculator.env
ExecStart=/usr/bin/node /opt/calculator/server.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/calculator
[Install]
WantedBy=multi-user.target
